{
  "name": "dsh-model-fold",
  "version": "1.0.0",
  "description": "把模型选择器按供应商折叠起来——每个供应商只占一行，点名称才展开它的模型，不用再一长条滚到底。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/LimiChan-2026/dsh-plugins/tree/main/packages/dsh-model-fold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LimiChan-2026/dsh-plugins.git",
    "directory": "packages/dsh-model-fold"
  },
  "bugs": {
    "url": "https://github.com/LimiChan-2026/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-selection",
    "ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
